# Copy to .env next to the compose file and fill in. Docker Compose reads .env
# automatically. Never commit your .env (it is in .gitignore): it holds secrets.
#
# Lines starting with "# NAME=" show the default; uncomment to change it.

# --- which compose file `docker compose up` / `down` use ------------------------------
# Default is docker-compose.yaml (mounts the Docker socket into the daemon).
# For the socket proxy variant, see README.md "Security", use:
# COMPOSE_FILE=docker-compose.proxy.yaml

# --- which prebake image ------------------------------------------------------------------------
# Default is the published image. Pin a version for reproducible deployments, or use a
# digest: ghcr.io/schorsch3000/prebake@sha256:...
# PREBAKE_IMAGE=ghcr.io/schorsch3000/prebake:latest

# --- config repo (required) --------------------------------------------------------------
# Git URL of the repo with prebake.yaml and containers/. For SSH URLs add the key printed
# at first start (`docker compose logs prebake`, or `docker compose exec prebake prebake
# show-key`) as a READ-ONLY deploy key.
REPO_URL=git@github.com:you/your-prebake-config.git
# REPO_BRANCH=main
# How often the repo is fetched.
# POLL_INTERVAL=5m

# --- scheduling ------------------------------------------------------------------------------
# The build slots from prebake.yaml are interpreted in the host's time zone: the compose files
# mount /etc/localtime read-only. Set TZ only to override that, e.g. Europe/Berlin (TZ wins
# over the mounted file). `docker compose exec prebake prebake status` and the status page show
# the zone in use.
# TZ=Europe/Berlin
# Which file is mounted as /etc/localtime. Needed on Docker Desktop (macOS/Windows), where
# /etc/localtime is the VM's UTC, not yours: point it at a zoneinfo file or just set TZ instead.
# LOCALTIME_FILE=/etc/localtime
# Builds start at a random offset up to this long after a slot opens; 0 disables.
# JITTER=15m

# --- Pushover notifications (leave both empty to disable) -----------------------------
# PUSHOVER_USER is your user key (dashboard front page), PUSHOVER_TOKEN is the API token of
# an application you create at https://pushover.net/apps/build . Set both or neither.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# --- TLS for the read-only registry (optional) ---------------------------------------
# Mount a directory with the files (uncomment the ./certs volume in the compose file) and
# set both. The files are reloaded when they change; without them it serves plain HTTP.
# TLS_CERT=/certs/tls.crt
# TLS_KEY=/certs/tls.key

# --- socket proxy variant only ----------------------------------------------------------
# Log level of the proxy: info logs blocked requests, debug logs allowed ones too.
# PROXY_LOGLEVEL=info

# --- more daemon settings (NOT passed on by the compose files) ---------------------------
# `prebake daemon --help` lists them. To use one, add it under `environment:` of the
# prebake service in your compose file, for example `KNOWN_HOSTS: /data/known_hosts`.
#   KNOWN_HOSTS    pinned known_hosts file; default is trust on first use
#   REGISTRY_HOST  host:port the Docker host pushes to (default localhost:5001)
#   VERBOSE        any value: log every registry request
#   DATA_DIR       /data      (the volume is mounted there)
#   READ_ADDR      :5000      \
#   WRITE_ADDR     :5001       } the published ports in the compose files assume these
#   STATUS_ADDR    :8080      /
#   PUSHOVER_TOKEN_FILE, PUSHOVER_USER_FILE   read the values from files (Docker secrets)
